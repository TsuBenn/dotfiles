# Font
font-family = JetBrainsMono Nerd Font
font-size = 11

# Window
background = 000000
window-padding-x = 0
window-padding-y = 10
background-opacity = 0.6

adjust-cell-width = 1
adjust-cell-height = 1

cursor-style = block

# URL
link-url = true

# Shell
command = bash

# Keybinds
keybind = ctrl+shift+i=scroll_up
keybind = ctrl+shift+k=scroll_down
keybind = ctrl+shift+p=clear_screen
