# Font
font-family = JetBrainsMono Nerd Font
font-style = medium
font-size = 10
font-feature = calt
font-feature = liga

# Window
background = 000000
background-opacity = 0.8

foreground = EDE6E8

palette = 0=#151214
palette = 1=#ec2727
palette = 2=#98BB6C
palette = 3=#eea022
palette = 4=#a32435
palette = 5=#f59b75
palette = 6=#2fbcf0
palette = 7=#EDE6E8
palette = 8=#1D191C
palette = 9=#ec2727
palette = 10=#98BB6C
palette = 11=#eea022
palette = 12=#a32435
palette = 13=#f59b75
palette = 14=#2fbcf0
palette = 15=#EDE6E8

# window-padding-y = 10

adjust-cell-width = 10%

cursor-style = block
mouse-hide-while-typing = true

confirm-close-surface = false

clipboard-read = allow
clipboard-write = allow

# URL
link-url = true

# Shell
command = zsh

keybind = ctrl+shift+j=unbind
keybind = ctrl+shift+n=unbind
keybind = ctrl+shift+q=unbind
keybind = ctrl+shift+w=unbind
keybind = ctrl+shift+a=unbind
