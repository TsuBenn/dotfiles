                    if (button == "L") {
                        root.back()
                    }
                }

            }

            CellText {

                text: "  Bluetooth"
                font: Cell.fontB

            }

        }

        RowLayout {

            anchors.right: parent.right
            anchors.rightMargin: Cell.w(1)

            spacing: Cell.w(1)

            CellLoading {
                visible: BluetoothInfo.scanning
                style: 2
