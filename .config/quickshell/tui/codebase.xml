                            onReleased: (button) => {
                                if (button != "L") return
                                MediaPlayerInfo.itterateLoop()
                            }

                        }


                    }

                }

            }

            CellSeparator {

                visible: !root.minimal

                w: box.contentW
                type: 0
                color: Colors.accentStrong
            }

            CellAudioVisual {

                visible: !root.minimal

                w: box.contentW-1
