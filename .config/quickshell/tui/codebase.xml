        };
        for (const bind of binds) {
            const regex = /^((c|ctrl|control)[-+])?((s|shift)[-+])?((a|alt)[-+])?(\S+)(!)?$/i;
            let match = bind.match(regex);
            let combo = "";
            let revised = "";
            if (match) {
                if (match[2]) {
                    combo += "ctrl+";
                    revised += "C-";
                }
                if (match[4]) {
                    combo += "shift+";
                    revised += "S-";
