        if (!root.editable)
            return;
        root.visualPos = 0;
        if (root.text[Math.max(root.cursorPos - 1, 0)] != " " && root.cursorPos > 0)
            root.cursorPos -= 1;
        while (root.cursorPos > 0 && root.text[root.cursorPos] != " ") {
