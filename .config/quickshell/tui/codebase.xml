                            clickable: MediaPlayerInfo.canPrev

                            padding: 0

                            color: MediaPlayerInfo.canPrev ? [Colors.bgOverlay, Colors.fgBase] : Colors.bgOverlay

                            onReleased: (button) => {
                                if (button != "L") return
