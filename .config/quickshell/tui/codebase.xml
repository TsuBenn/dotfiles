            "multiply": "*",
            "star": "*"
        };
        let special = {
            "print": "print",
            "ret": "return",
            "bs": "backspace",
            "pup": "pgup",
            "pdwn": "pgdown",
            "end": "end",
            "tab": "tab",
            "del": "delete",
            "f1": "f1",
            "f2": "f2",
            "f3": "f3",
            "f4": "f4",
            "f5": "f5",
            "f6": "f6",
            "f7": "f7",
            "f8": "f8",
