                            }
                            Deps {
                                visible: (info.datas?.provides ?? []).length > 0
                                key: "Provides"
                                values: (info.datas?.provides ?? []).map(
                                    n => ({ name: n, installed: PacmanInfo.isInstalled(n) })
                                )
                            }

