                                    n => ({ name: n, installed: PacmanInfo.isInstalled(n) })
                                )
                            }
                            Deps {
                                visible: (info.datas?.replaces ?? []).length > 0
                                key: "Replaces"
                                values: (info.datas?.replaces ?? []).map(
                                    n => ({ name: n, installed: PacmanInfo.isInstalled(n) })
