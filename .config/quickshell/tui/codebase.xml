                            }

                        }

                        CellButton {

                            id: button

                            text: MediaPlayerInfo.status == "playing" ? " 1 " : " 0 "
                            font: Cell.fontB
                            fg: MediaPlayerInfo.activePlayer ? [Colors.bgSurface, Colors.fgBase] : Colors.fgSubtle

                            padding: 0

                            color: MediaPlayerInfo.activePlayer ? [Colors.fgBase, Colors.bgOverlay] : Colors.bgOverlay

                            onReleased: (button) => {
                                if (button != "L") return
