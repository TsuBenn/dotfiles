                            CalendarInfo.add(mde, title_textfield.text, body_textfield.text, date, ur, time, span)
                        } else {
                            CalendarInfo.edit(mde, title_textfield.text, body_textfield.text, date, edit.origin.index, ur, time, span)
                        }
                        root.edit = false

                    }
