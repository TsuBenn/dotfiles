                        }
                    } else {
                        key = match[7];
                    }
                    if (key) {
                        combo += key.toLowerCase();
                        revised += abb?.toUpperCase() ?? match[7].toUpperCase();
                    } else {
                        combo = "";
                        revised += match[7].toUpperCase() + "!";
                    }
                }
                if (match[8]) {
                    combo = "";
                    revised += "!";
                }
