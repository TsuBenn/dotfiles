    h: Cell.hCount(layout.implicitHeight) + 2

    shortcuts: [
        {
            binds: "Space",
            action: () => {
                MediaPlayerInfo.playPauseMedia()
            }
        },
        {
            binds: ["D", "L","Right"],
            action: () => {
                MediaPlayerInfo.nextMedia()
            }
        },
        {
            binds: ["A", "J","Left"],
            action: () => {
                MediaPlayerInfo.prevMedia()
            }
        },
    ]

    CellBox {

        id: box

        w: root.w
        h: root.h

        ColumnLayout {

            id: layout

            spacing: 0

            RowLayout {

                spacing: 0

                CellText {
                    text: " "
