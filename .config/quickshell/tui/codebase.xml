    function saveConfig() {
        let config = {
            "binds": root.binds,
            "custom_actions": root.custom_actions
        };
        loader.setText(JSON.stringify(config, null, 2));
    }

    function decodeBinds(binds: var): var {
        let usage = [];
        let display = [];
        let abbriviate = {
            "pageup": "pup",
            "pagedown": "pdown",
            "return": "ret",
            "backspace": "bs",
            "delete": "del",
            "up": "↑",
            "left": "←",
            "down": "↓",
            "right": "→",
            "plus": "+",
            "minus": "-",
            "equal": "=",
            "semicolon": ";",
            "colon": ":",
