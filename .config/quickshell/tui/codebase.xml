        onLoaded: {
            if (text()) {
                root.recent = JSON.parse(text())
            }
        }

    }

    FileView {

        id: loader

        path: SystemInfo.configdir + "/scripts/emojis.json"

        onLoaded: {
            if (text()) {
                root.emojis = JSON.parse(text())
