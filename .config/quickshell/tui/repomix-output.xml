            LockInfo.unlock.connect(()=>{
                this.locked = false
            })
        }

        LockSession {

            monitor: screen != null ? HyprInfo.monitors[screen.name] : {"width": 1920, "height": 1080}

        }

    }

    Loader {

        active: !SettingsInfo.dependenciesChecked

