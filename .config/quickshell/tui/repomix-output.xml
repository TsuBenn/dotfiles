                                WidgetSep {}

                                PreviewWidget {

                                    label: "Buttons"

                                    RowLayout {

                                        spacing: Cell.w(1)

                                        CellButton {
                                            text: "Click me!"
                                            color: [color.color.accentStrong, color.color.bgOverlay]
