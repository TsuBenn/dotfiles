import qs.config
import qs.modules
import qs.services

import QtQuick.Layouts
import QtQuick

ColumnLayout {

    id: root

    property var box

    spacing: 0

    onVisibleChanged: {
        NotificationsInfo.refresh()
        list.expanded = []
    }

    CellScrollView {

        id: list

        w: root.box.contentW
        h: 25

        property var expanded: []

        property var expanded_notif: []

        signal collapse_all()
        signal expand_all()

        onExpand_all: {
            for (const app of NotificationsInfo.notifications_groups) {
                expanded = [...expanded,app.app]
                for (const group of app.notifications) {
                    expanded_notif = [...expanded_notif,group.object]
                }
            }
        }

        onCollapse_all: {
            expanded = []
            expanded_notif = []
        }

        ColumnLayout {

            spacing: 0

            Repeater {

                model: NotificationsInfo.notifications_groups

                delegate: Loader {

                    id: apps

                    required property var modelData

                    active: root.visible

