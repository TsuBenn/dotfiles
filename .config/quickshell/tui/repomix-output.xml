                                Layout.leftMargin: Cell.w(1)

                                property int label_width: 14
                                property int widgets_width: preview.w - 2 - label_width

                                spacing: 0

                                component PreviewWidget: RowLayout {

                                    spacing: 0

                                    property string label: "Buttons"
                                    property int label_width: 14

