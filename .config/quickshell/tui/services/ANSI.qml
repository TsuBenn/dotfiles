    function render(text: string, font=root.font): string {
        const height = 4
        const rows = Array(height).fill("")
        text = text.toUpperCase()

        for (const char of text.toUpperCase()) {
            if (!(char in font)) continue
            const glyph = font[char]
            for (let i = 0; i < height; i++) {
                rows[i] += glyph[i]
            }
        }

        return rows.join("\n")
    }

