    function render(text: string, id=0): string {
        const height = root.font[id][0].length
        const rows = Array(height).fill("")
        text = text.toUpperCase()

        for (const char of text.toUpperCase()) {
            if (!(char in root.font[id])) continue
            const glyph = root.font[id][char]
            for (let i = 0; i < height; i++) {
                rows[i] += glyph[i]
            }
        }

        return rows.join("\n")
    }

