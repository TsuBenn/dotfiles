		this.major = major;
	}
	public double getGpa() {
		return gpa;
	}
	public void setGpa(float gpa) {
		this.gpa = gpa;
	}

	public static int getIdIterator() {
		return idIterator;
	}

	public static void setIdIterator(int idIterator) {
		Student.idIterator = idIterator;
	}

	public void setGpa(double gpa) {
