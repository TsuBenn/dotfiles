<file path="pig_latin.rs">
const VOWELS: [char; 5] = ['a','i','u','e','o'];
const CLUSTERS: [&str; 14] = [
    "th", "br", "bl", "cl", "cr",
    "dr", "fl", "fr", "gr", "pl",
    "pr", "st", "tr", "qu"
];

pub fn convert(input: &str) -> String {
    let mut words: Vec<String> = Vec::new();
    for word in input.split_whitespace() {
        if word.starts_with(&VOWELS) {
            words.push(format!("{}-hay",word));
        } else {
            let mut word = word.to_owned();
            let mut consonant: String = word.remove(0).to_string();
            if CLUSTERS.contains(&&format!("{}{}", consonant, word.chars().next().unwrap())[..]) {
                consonant.push_str(&word.remove(0).to_string());
            }
            words.push(format!("{}-{}ay", capitalize(&word), consonant.to_lowercase()));
        }
    }
    words.join(" ")
}

fn capitalize(str: &str) -> String {
    let mut word = str.to_owned();
    let first_letter = word.remove(0);
    format!("{}{}",first_letter.to_uppercase(),word.to_lowercase())
}
