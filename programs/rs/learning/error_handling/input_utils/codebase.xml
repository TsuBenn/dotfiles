                            println!("This field cannot be empty!");
                            continue;
                        }
                    }
                },
                ReaderError::Err => {
                    println!("Invalid Integer!");
                    continue;
                }
            }
        }
    }
}

pub fn get_float_no_empty(prompt: &str) -> f64 {
