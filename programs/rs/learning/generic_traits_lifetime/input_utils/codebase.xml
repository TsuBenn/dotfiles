<file path="parse.rs">
use std::str::FromStr;

const TRUE_CHAR: [&str; 5] = [
    "y", "yes", "1", "t", "true"
];

const FALSE_CHAR: [&str; 5] = [
    "n", "no", "0", "f", "false"
];

pub fn parse_num<T: FromStr>(input: &str) -> Option<T> {
    input.parse::<T>().ok()
}

pub fn parse_bool(input: &str) -> Option<bool> {
    let first_char = input.chars().next()?.to_lowercase().to_string();
    if TRUE_CHAR.contains(&first_char.as_str()) {
        return Some(true);
    } else if FALSE_CHAR.contains(&first_char.as_str()) {
        return Some(false);
    }
    None
}
